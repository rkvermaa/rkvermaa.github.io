---
import { books } from "@/data/books";
import { journey } from "@/data/journey";
import { projects } from "@/data/projects";
import { writing } from "@/data/writing";
import { siteConfig } from "@/site-config";
import { withBase } from "@/utils/path";
import ThemeToggle from "../ThemeToggle.astro";

const name = siteConfig.profile?.name ?? siteConfig.author;

const links: { title: string; path: string }[] = [
	{ title: "Home", path: "/" },
	{ title: "About", path: "/about/" },
	{ title: "Life", path: "/life/" },
	{ title: "Journey", path: "/journey/" },
	{ title: "Experience", path: "/experience/" },
	...(projects.length > 0 ? [{ title: "Projects", path: "/projects/" }] : []),
	...(writing.length > 0 ? [{ title: "Writing", path: "/writing/" }] : []),
	...(books.length > 0 ? [{ title: "Books", path: "/books/" }] : []),
	{ title: "Play", path: "/play/" },
	{ title: "Book a call", path: "/book/" },
	{ title: "Contact", path: "/contact/" },
];

/**
 * Every year from the first journey entry to now, oldest first, so the row reads like a
 * timeline. Years with a journey entry link to it; the others are shown dimmed.
 */
const journeyYears = new Set(journey.map((entry) => entry.year));
const firstYear = Math.min(...journeyYears);
const thisYear = new Date().getFullYear();
const years =
	journeyYears.size > 0
		? Array.from({ length: thisYear - firstYear + 1 }, (_, i) => firstYear + i)
		: [];
---

<footer class="site-footer">
	<span class="line" aria-hidden="true"></span>
	<a class="signature" href={withBase("/")} aria-label={`${name}, home`}>Ravi Kumar Verma</a>
	<p class="made">
		Made with
		<svg class="heart" aria-label="love" role="img" width="14" height="14" viewBox="0 0 24 24"><path d="M12 21s-8-5-8-11.2A4.6 4.6 0 0 1 12 6.6a4.6 4.6 0 0 1 8 3.2C20 16 12 21 12 21z" fill="#e0245e"></path></svg>
		by {name}
	</p>
	<p class="bio">
		AI engineer from Kanpur, India. 14 years in tech, from telecom officer at BSNL to building AI
		agents that work outside the demo.
	</p>
	<nav class="links" aria-label="Footer">
		{links.map((item) => <a href={withBase(item.path)}>{item.title}</a>)}
	</nav>
	{
		years.length > 0 && (
			<nav class="years" aria-label="Journey by year">
				{years.map((year) =>
					journeyYears.has(year) ? (
						<a href={withBase(`/journey/#y${year}`)}>{year}</a>
					) : (
						<span class="quiet-year">{year}</span>
					),
				)}
			</nav>
		)
	}
	<div class="theme">
		<ThemeToggle />
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 96px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 14px;
		font-family: var(--font-sans);
		color: hsl(var(--theme-text) / 0.72);
	}
	.line {
		width: 1px;
		height: 64px;
		background: hsl(var(--theme-text) / 0.6);
		margin-bottom: 8px;
	}
	.signature {
		font-family: var(--font-signature);
		font-size: 44px;
		line-height: 1.2;
		color: hsl(var(--theme-text));
		transform: rotate(-6deg);
		padding: 0 12px;
	}
	.made {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}
	.heart {
		flex: none;
	}
	.bio {
		margin: 4px 0 0;
		max-width: 46ch;
		font-size: 14.5px;
		line-height: 1.6;
	}
	.links,
	.years {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 6px 18px;
		font-size: 14.5px;
	}
	.links {
		margin-top: 10px;
	}
	.years {
		margin-top: 6px;
		max-width: 960px;
		gap: 6px 12px;
		font-size: 13.5px;
		font-variant-numeric: tabular-nums;
	}
	.theme {
		margin-top: 10px;
	}
	.quiet-year {
		color: hsl(var(--theme-text) / 0.35);
	}
	.site-footer a {
		color: hsl(var(--theme-text));
		transition: color 0.2s ease;
	}
	.site-footer a:hover {
		color: hsl(var(--theme-accent));
	}
	.site-footer a:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
		border-radius: 3px;
	}

	@media (max-width: 420px) {
		.signature {
			font-size: 36px;
		}
		.links,
		.years {
			gap: 4px 14px;
			font-size: 13.5px;
		}
	}
</style>
