---
import { projects, stackLine } from "@/data/projects";
import ProjectOverlays from "@/components/ProjectOverlays.astro";
import PageLayout from "@/layouts/Base.astro";
import { absoluteUrl } from "@/utils/path";
import { Schema } from "astro-seo-schema";

const siteUrl = (path: string) => absoluteUrl(path, Astro.site);
---

<Schema
	item={{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "Home",
				item: siteUrl("/"),
			},
			{
				"@type": "ListItem",
				position: 2,
				name: "Projects",
				item: siteUrl("/projects/"),
			},
		],
	}}
/>

<PageLayout
	meta={{
		title: "Projects",
		description:
			"Selected work in GenAI, multi-agent systems, data engineering and machine learning.",
	}}
>
	<section class="work" aria-labelledby="work-label">
		<div class="section-label" id="work-label">Projects</div>
		<p class="intro">
			Products I'm building and work I've led across GenAI, data engineering and machine learning.
			Client work isn't public, so the descriptions are what I can share. Click a project for
			details.
		</p>
		<ul class="work-list">
			{
				projects.map((project) => {
					const body = (
						<>
							<div class="head">
								<span class="name">{project.name}</span>
								{project.badge && <span class="badge">{project.badge}</span>}
							</div>
							<div class="stack">{stackLine(project)}</div>
							<p>{project.desc}</p>
						</>
					);
					return (
						<li>
							<a href={`#project-${project.slug}`} data-project={project.slug}>
								{body}
								<span class="more">Details ›</span>
							</a>
						</li>
					);
				})
			}
		</ul>
	</section>
	<ProjectOverlays />
</PageLayout>

<style>
	.work {
		margin-bottom: 88px;
	}
	.intro {
		font-family: var(--font-serif);
		font-size: 17.5px;
		line-height: 1.7;
		color: hsl(var(--theme-text));
		margin: 0 0 36px;
		max-width: 60ch;
		text-wrap: pretty;
	}
	.more {
		display: inline-block;
		margin-top: 8px;
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: 0.04em;
		color: hsl(var(--theme-accent));
	}
	/* Project names are long enough that name + stack + badge on one line
	   wraps unpredictably; the stack gets its own line instead. */
	.work :global(ul.work-list .head) {
		margin-bottom: 4px;
	}
	.work :global(ul.work-list .stack) {
		display: block;
	}
	.work :global(ul.work-list .badge) {
		flex: none;
	}

	@media (max-width: 720px) {
		.intro {
			font-size: 17px;
			margin-bottom: 28px;
		}
	}
	@media (max-width: 420px) {
		.work {
			margin-bottom: 56px;
		}
		.intro {
			font-size: 16.5px;
		}
	}
</style>
