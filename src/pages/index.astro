---
import { books, coverFor } from "@/data/books";
import { experience } from "@/data/experience";
import { education } from "@/data/education";
import { life, now, tiles } from "@/data/home";
import { timeline } from "@/data/timeline";
import { writing } from "@/data/writing";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
import { absoluteUrl, withBase } from "@/utils/path";
import { Schema } from "astro-seo-schema";

const profile = siteConfig.profile;
const email = profile?.email ?? "rkverma87@gmail.com";
const siteUrl = (path: string) => absoluteUrl(path, Astro.site);

const recentRoles = experience.slice(0, 3);
const recentWriting = writing.slice(0, 3);
/** Reading now first, then finished ones. The home shelf shows two rows; /books/ shows them all. */
const withCover = books.filter((b) => coverFor(b));
const shelf = [...withCover.filter((b) => b.status === "reading"), ...withCover.filter((b) => b.status !== "reading")];
const SHELF_MAX = 18; // 2 rows × 9 covers

/** Internal "#anchor" and root-relative links get the base path; others pass through. */
const link = (href: string) => (href.startsWith("#") ? href : withBase(href));
const isExternal = (href: string) => /^https?:\/\//.test(href);

/** "2025, Aug–Dec" for same-year roles, "2021–2023" otherwise. */
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const yearOf = (ym: string) => ym.slice(0, 4);
const monthOf = (ym: string) => MONTHS[Number(ym.slice(5, 7)) - 1] ?? "";
const roleDates = (start: string, end: string) => {
	if (end === "present") return `${yearOf(start)}–now`;
	if (yearOf(start) === yearOf(end)) return `${yearOf(start)}, ${monthOf(start)}–${monthOf(end)}`;
	return `${yearOf(start)}–${yearOf(end)}`;
};

/** Simple 24×24 stroke icons for the /elsewhere links. */
const ICON = {
	linkedin:
		'<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/>',
	github:
		'<path d="M9 19c-4 1.3-4-2-6-2.5M15 21v-3.5a3 3 0 0 0-.9-2.3c3-.3 6.2-1.5 6.2-6.7a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.6s-1.1-.3-3.7 1.4a12.7 12.7 0 0 0-6.6 0C6.3 1 5.2 1.3 5.2 1.3a4.8 4.8 0 0 0-.1 3.6 5.2 5.2 0 0 0-1.4 3.6c0 5.2 3.2 6.4 6.2 6.7a3 3 0 0 0-.9 2.3V21"/>',
	medium: '<circle cx="7" cy="12" r="4.5"/><ellipse cx="15.5" cy="12" rx="2" ry="4.5"/><path d="M20.5 7.5v9"/>',
	instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5v.01"/>',
	youtube: '<rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 5 3-5 3z"/>',
	facebook: '<path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V10H6.5v3.5H9V21h3.5v-7.5H15l.5-3.5h-3V7a1 1 0 0 1 1-1H15z"/>',
};

const BUG_HAI_BHAI_INSTAGRAM = "https://www.instagram.com/bug_hai_bhai/";
const BUG_HAI_BHAI_YOUTUBE = "https://www.youtube.com/@bug_hai_bhai";

/**
 * /elsewhere: social profiles, then the publications I've been published in
 * (each links to my best story there).
 */
type ElsewhereLink = { label: string; href: string; color: string; icon?: string; text?: string; title?: string };
const elsewhere: ElsewhereLink[] = [
	...(profile?.linkedin ? [{ label: "LinkedIn", href: profile.linkedin, icon: ICON.linkedin, color: "#0a66c2" }] : []),
	...(profile?.github ? [{ label: "GitHub", href: profile.github, icon: ICON.github, color: "#1a1a1a" }] : []),
	...(profile?.medium ? [{ label: "Medium", href: profile.medium, icon: ICON.medium, color: "#000000" }] : []),
	{
		label: "YouTube",
		href: BUG_HAI_BHAI_YOUTUBE,
		icon: ICON.youtube,
		color: "#e62117",
		title: "Bug Hai Bhai on YouTube",
	},
	{
		label: "Instagram",
		href: BUG_HAI_BHAI_INSTAGRAM,
		icon: ICON.instagram,
		color: "#d62976",
		title: "Bug Hai Bhai on Instagram",
	},
	{
		label: "Facebook",
		href: "https://www.facebook.com/bug.hai.bhai/",
		icon: ICON.facebook,
		color: "#1877f2",
		title: "Bug Hai Bhai on Facebook",
	},
	{
		label: "Towards AI",
		text: "TA",
		color: "#1a73e8",
		title: "Published in Towards AI",
		href: "https://medium.com/towards-artificial-intelligence/the-complete-rag-playbook-part-1-building-your-first-rag-pipeline-a0c1a15440fa",
	},
	{
		label: "Stackademic",
		text: "S",
		color: "#111111",
		title: "Published in Stackademic",
		href: "https://medium.com/stackademic/i-ran-a-github-repo-with-20k-stars-on-a-beauty-product-it-built-my-entire-marketing-strategy-7591d97c70a7",
	},
	{
		label: "AI in Plain English",
		text: "AI",
		color: "#7a4fd6",
		title: "Published in AI in Plain English",
		href: "https://medium.com/ai-in-plain-english/from-50-files-to-one-graph-how-graphify-turns-code-into-knowledge-de96cfbf3fbc",
	},
	{
		label: "Level Up Coding",
		text: "LU",
		color: "#e4572e",
		title: "Published in Level Up Coding",
		href: "https://medium.com/gitconnected/tokenization-without-it-ai-would-choke-on-new-words-a8bbc11c46ce",
	},
];

/** Four focus areas; the full skill list lives on /skills/. */
const expertise = [
	{ title: "Agentic AI", detail: "Multi-agent systems and agentic workflows" },
	{ title: "Agent infrastructure", detail: "Harnesses, skills and MCP integrations" },
	{ title: "RAG & knowledge", detail: "Retrieval, vector search, knowledge graphs" },
	{ title: "Data & ML platforms", detail: "Lakehouses, forecasting and production ML" },
];

/** Latest four events from the /life timeline. */
const recent = [...timeline].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 4);
const SHORT_MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
/** Static fallback before the browser swaps in "3 weeks ago". */
const shortDate = (date: string) => {
	const [y, m] = date.split("-");
	return m ? `${SHORT_MONTHS[Number(m) - 1]} ${y}` : y;
};

/** The three games on /play/, shown as small cards. */
const games = [
	{
		title: "Tic-tac-toe",
		detail: "I never lose. Can you draw?",
		href: "/play/#ttt-h",
		color: "#2e6be6",
		icon: '<path d="M9 3v18M15 3v18M3 9h18M3 15h18"/>',
	},
	{
		title: "Memory match",
		detail: "Find eight pairs of tech terms",
		href: "/play/#mem-h",
		color: "#7a4fd6",
		icon: '<rect x="3" y="4" width="8" height="12" rx="1.5"/><rect x="13" y="8" width="8" height="12" rx="1.5"/>',
	},
	{
		title: "Reaction test",
		detail: "How fast are your fingers?",
		href: "/play/#rx-h",
		color: "#e4572e",
		icon: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2M9 2h6"/>',
	},
];
---

<Schema
	item={{
		"@context": "https://schema.org",
		"@type": "Person",
		name: profile?.name ?? siteConfig.author,
		url: siteUrl("/"),
		jobTitle: profile?.jobTitle,
		email: profile?.email,
		sameAs: [profile?.github, profile?.linkedin, profile?.medium].filter(
			(u): u is string => typeof u === "string" && u.length > 0,
		),
	}}
/>

<PageLayout meta={{ title: "Home", description: siteConfig.description }} wide>
	<section class="hero" aria-labelledby="now-h">
		<p class="signature" aria-hidden="true">Ravi Kumar Verma</p>
		<h1 class="visually-hidden">{profile?.name ?? siteConfig.author}</h1>
		<div class="now">
			<h2 class="label" id="now-h">/now</h2>
			<ul>
				{
					now.map((item) => (
						<li>{item.before}{" "}{item.href ? (<a class="mark-link" href={link(item.href)} {...(isExternal(item.href) ? { rel: "noreferrer", target: "_blank" } : {})}><span class="mark" style={`background:${item.color}`} aria-hidden="true" />{item.name}</a>) : (<strong class="mark-link"><span class="mark" style={`background:${item.color}`} aria-hidden="true" />{item.name}</strong>)}{item.after}{item.cta && (<>{" "}<a class="cta-link" href={item.cta.href}>{item.cta.label} ›</a></>)}</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="life" aria-labelledby="life-h">
		<h2 class="label" id="life-h"><a href={withBase("/life/")} data-astro-prefetch>/life ›</a></h2>
		<ul class="life-grid">
			{
				life.map((fact) => (
					<li>
						<svg
							aria-hidden="true"
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke={fact.color}
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							set:html={fact.icon}
						/>
						<div>
							{fact.href ? (
								<a class="life-title life-link" href={fact.href} rel="noreferrer" target="_blank">
									{fact.title}
								</a>
							) : (
								<span class="life-title">{fact.title}</span>
							)}
							<span class="life-detail" data-live={fact.live}>{fact.detail}</span>
						</div>
					</li>
				))
			}
		</ul>
	</section>

	<!-- Three columns: a mono /label, then a plain list. -->
	<div class="sections">
		<section aria-labelledby="edu-h">
			<h2 class="label" id="edu-h"><a href={withBase("/about/")} data-astro-prefetch>/education</a></h2>
			<ul class="dots">
				{
					education.map((item) => (
						<li>
							<span class="item-title">{item.degree}<span class="item-sub"> · {item.institution}</span></span>
							<span class="item-detail">
								{item.start}–{item.end === "present" ? "now" : item.end}
								{item.field ? ` · ${item.field}` : ""}
							</span>
						</li>
					))
				}
			</ul>
		</section>

		<section aria-labelledby="exp-h">
			<h2 class="label" id="exp-h"><a href={withBase("/experience/")} data-astro-prefetch>/experience</a></h2>
			<ul class="dots">
				{
					recentRoles.map((role) => (
						<li>
							<span class="item-title">{role.role}<span class="item-sub"> · {role.company}</span></span>
							<span class="item-detail">
								{roleDates(role.start, role.end)}
								{role.remote && (
									<span class="wfh">
										{" · "}
										<svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg>
										Work from home
									</span>
								)}
							</span>
						</li>
					))
				}
			</ul>
		</section>

		{
			recentWriting.length > 0 && (
				<section aria-labelledby="writing-h">
					<h2 class="label" id="writing-h"><a href={withBase("/writing/")} data-astro-prefetch>/blog</a></h2>
					<ul class="dots">
						{recentWriting.map((item) => (
							<li>
								<a href={item.href} rel="noreferrer" target="_blank">
									<span class="item-title">{item.title}<span class="item-sub"> · {item.source}</span></span>
									{item.description && <span class="item-detail">{item.description}</span>}
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<section aria-labelledby="proj-h">
			<h2 class="label" id="proj-h"><a href={withBase("/projects/")} data-astro-prefetch>/projects</a></h2>
			<ul class="tiles soft-card">
				{
					tiles.map((tile) => {
						const href = tile.href ? link(tile.href) : withBase("/projects/");
						const external = tile.href ? isExternal(tile.href) : false;
						return (
							<li>
								<a class="tile-link" href={href} title={tile.name} {...(external ? { rel: "noreferrer", target: "_blank" } : {})}>
									<span
										class:list={["tile", { outline: tile.outline }]}
										style={`background:${tile.bg};color:${tile.fg}`}
										aria-hidden="true"
									>
										{tile.icon ? (
											<svg
												width="24"
												height="24"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
												set:html={tile.icon}
											/>
										) : (
											<span class="tile-text">{tile.text}</span>
										)}
									</span>
									<span class="tile-name">{tile.name}</span>
								</a>
							</li>
						);
					})
				}
			</ul>
		</section>

		<section aria-labelledby="play-h">
			<h2 class="label" id="play-h"><a href={withBase("/play/")} data-astro-prefetch>/play</a></h2>
			<ul class="games">
				{
					games.map((game) => (
						<li>
							<a class="game" href={withBase(game.href)}>
								<span class="game-icon" style={`background:${game.color}`} aria-hidden="true">
									<svg
										width="22"
										height="22"
										viewBox="0 0 24 24"
										fill="none"
										stroke="#ffffff"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										set:html={game.icon}
									/>
								</span>
								<span class="game-text">
									<span class="item-title">{game.title}</span>
									<span class="item-detail">{game.detail}</span>
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section id="piecewise" aria-labelledby="pw-h">
			<h2 class="label" id="pw-h">/piecewise</h2>
			<div class="pw-card">
				<div class="pw-shot" role="img" aria-label="Piecewise app screenshot (coming soon)">
					<span class="pw-logo" aria-hidden="true">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="1.5"></rect><rect x="13" y="13" width="8" height="8" rx="1.5"></rect><path d="M11 7h4a2 2 0 0 1 2 2v4"></path></svg>
					</span>
					Screenshot coming soon
				</div>
				<div class="pw-body">
					<p class="body">
						AI agents on rails. Agents run through workflows your team defines and approves, with
						your own skills, connectors and LLM keys, so cost per run is predictable.
					</p>
					<a class="cta-link" href={`mailto:${email}?subject=Piecewise%20pilot`}>Request a free pilot ›</a>
				</div>
			</div>
		</section>

		<!-- Last row: expertise, elsewhere, recently. -->
		<section aria-labelledby="skills-h">
			<h2 class="label" id="skills-h"><a href={withBase("/skills/")} data-astro-prefetch>/expertise</a></h2>
			<ul class="dots">
				{
					expertise.map((area) => (
						<li>
							<a href={withBase("/skills/")}>
								<span class="item-title">{area.title}</span>
								<span class="item-detail">{area.detail}</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section aria-labelledby="elsewhere-h">
			<h2 class="label" id="elsewhere-h">/elsewhere</h2>
			<ul class="badges">
				{
					elsewhere.map((item) => (
						<li>
							<a href={item.href} rel="noreferrer" target="_blank" title={item.title}>
								<span class="badge" style={`background:${item.color}`} aria-hidden="true">
									{item.icon ? (
										<svg
											width="13"
											height="13"
											viewBox="0 0 24 24"
											fill="none"
											stroke="#ffffff"
											stroke-width="2.2"
											stroke-linecap="round"
											stroke-linejoin="round"
											set:html={item.icon}
										/>
									) : (
										<span class="badge-text">{item.text}</span>
									)}
								</span>
								<span>{item.label}</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section aria-labelledby="recent-h">
			<h2 class="label" id="recent-h"><a href={withBase("/life/")} data-astro-prefetch>/recently</a></h2>
			<ol class="recent">
				{
					recent.map((event) => (
						<li>
							<a href={withBase("/life/")}>
								<span class="recent-title">{event.title}</span>
								<time class="recent-when" datetime={event.date} data-ago={event.date}>
									{shortDate(event.date)}
								</time>
							</a>
						</li>
					))
				}
			</ol>
		</section>

	</div>

	<!-- Closing row: the bookshelf on the left, the "work with me" tile on the right. -->
	<div class:list={["closing", { "no-books": shelf.length === 0 }]}>
	{
		shelf.length > 0 && (
			<section class="bookshelf" aria-labelledby="books-h">
				<h2 class="label" id="books-h">
					<a href={withBase("/books/")} data-astro-prefetch>/books ›</a>
				</h2>
				<ul class="shelf" aria-label="Books I've read">
					{shelf.slice(0, SHELF_MAX).map((book) => {
						const cover = coverFor(book);
						return (
							<li class="book">
								<a href={withBase("/books/")} title={`${book.title} by ${book.author}`}>
									{cover ? (
										<img src={cover} alt={`${book.title} by ${book.author}`} loading="lazy" width="56" height="84" />
									) : (
										<span class="book-fallback">{book.title}</span>
									)}
									{book.status === "reading" && <span class="reading-tag">Now</span>}
								</a>
							</li>
						);
					})}
				</ul>
				<a class="all-books" href={withBase("/books/")} data-astro-prefetch>
					All {books.length} books ›
				</a>
			</section>
		)
	}

		<section id="hire" class="hire" aria-labelledby="hire-h">
			<h2 class="label" id="hire-h">/work-with-me</h2>
			<div class="hire-card">
				<p>
					I help teams ship AI agents that hold up in production. The first call is free.
				</p>
				<ul class="chips" aria-label="Areas">
					<li>Agentic workflows</li>
					<li>Multi-agent systems</li>
					<li>MCP & skills</li>
					<li>RAG</li>
				</ul>
				<div class="hire-actions">
					<a class="button" href={`mailto:${email}?subject=Let%27s%20talk`}>Book a 20-minute call</a>
					<a class="hire-email" href={`mailto:${email}`}>or email me</a>
				</div>
			</div>
		</section>
	</div>
</PageLayout>

<script>
	// Live local time in India for the /life row, e.g. "It's 5:02 PM here (UTC +05:30)".
	const fmt = new Intl.DateTimeFormat("en-US", {
		hour: "numeric",
		minute: "2-digit",
		timeZone: "Asia/Kolkata",
	});
	const tick = () => {
		for (const el of document.querySelectorAll<HTMLElement>('[data-live="india-time"]')) {
			el.textContent = `It's ${fmt.format(new Date())} here (UTC +05:30)`;
		}
	};
	tick();
	setInterval(tick, 30_000);

	// "/recently": turn exact dates into "3 weeks ago"; year-only dates stay as the year.
	const rtf = new Intl.RelativeTimeFormat("en", { numeric: "auto" });
	for (const el of document.querySelectorAll<HTMLElement>("[data-ago]")) {
		const raw = el.dataset.ago ?? "";
		if (raw.length < 7) continue;
		const days = Math.round((Date.parse(raw.length === 7 ? `${raw}-01` : raw) - Date.now()) / 86_400_000);
		const [value, unit]: [number, Intl.RelativeTimeFormatUnit] =
			Math.abs(days) < 14
				? [days, "day"]
				: Math.abs(days) < 70
					? [Math.round(days / 7), "week"]
					: Math.abs(days) < 365
						? [Math.round(days / 30), "month"]
						: [Math.round(days / 365), "year"];
		el.textContent = rtf.format(value, unit);
	}
</script>

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	.label {
		margin: 0 0 18px;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 400;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: hsl(var(--theme-text) / 0.62);
	}
	.label a:hover {
		color: hsl(var(--theme-accent));
	}

	/* ---------- Hero ---------- */
	.hero {
		max-width: 620px;
		margin: 56px auto 80px;
	}
	.signature {
		margin: 0 0 56px;
		text-align: center;
		font-family: var(--font-signature);
		font-size: 80px;
		line-height: 1.1;
		white-space: nowrap;
		color: hsl(var(--theme-text));
		transform: rotate(-6deg);
	}
	.now ul {
		margin: 0;
		padding-left: 18px;
		list-style: disc;
		font-size: 16.5px;
		line-height: 1.65;
		color: hsl(var(--theme-text) / 0.88);
	}
