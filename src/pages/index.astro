---
import { experience } from "@/data/experience";
import { projects, stackLine } from "@/data/projects";
import { writing } from "@/data/writing";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
import { formatDateRange, toDateTimeRange } from "@/utils/date";
import { absoluteUrl, withBase } from "@/utils/path";
import { Schema } from "astro-seo-schema";

const profile = siteConfig.profile;
const siteUrl = (path: string) => absoluteUrl(path, Astro.site);

const recentRoles = experience.slice(0, 3);
const featuredProjects = projects.filter((project) => project.featured).slice(0, 3);
const recentWriting = writing.slice(0, 3);

/** Blank lines in `intro` separate paragraphs — render them as real <p>s so the
 *  spacing is controlled by CSS rather than a literal empty line. */
const introParagraphs = (siteConfig.intro ?? siteConfig.description)
	.split(/\n\s*\n/)
	.map((para) => para.trim())
	.filter(Boolean);
---

<Schema
	item={{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "Home",
				item: siteUrl("/"),
			},
			{
				"@type": "ListItem",
				position: 2,
				name: "Experience",
				item: siteUrl("/experience/"),
			},
			{
				"@type": "ListItem",
				position: 3,
				name: "Projects",
				item: siteUrl("/projects/"),
			},
		],
	}}
/>

<PageLayout meta={{ title: "Home", description: siteConfig.description }}>
	<section class="hero">
		<div class="hero-grid">
			{profile?.avatar && (
				<img
					class="portrait"
					src={withBase(profile.avatar)}
					alt={profile.name ?? siteConfig.author}
					width="640"
					height="800"
					decoding="async"
				/>
			)}
			<div class="hero-text">
		{introParagraphs.map((para) => <p>{para}</p>)}
		<div class="socials">
			{profile?.github && (
				<>
					<a href={profile.github} rel="noreferrer" target="_blank">GitHub</a>
					<span class="sep">·</span>
				</>
			)}
			{profile?.linkedin && (
				<>
					<a href={profile.linkedin} rel="noreferrer" target="_blank">LinkedIn</a>
					<span class="sep">·</span>
				</>
			)}
			{profile?.email && (
				<>
					<a href={`mailto:${profile.email}`}>Email</a>
					<span class="sep">·</span>
				</>
			)}
			{profile?.resume && (
				<>
					<a href={withBase(profile.resume)}>Résumé</a>
					<span class="sep">·</span>
				</>
			)}
			<a href={withBase("/contact/")} data-astro-prefetch>Contact</a>
		</div>
				<div class="more">
					<a data-astro-prefetch href={withBase("/about/")}>More about me →</a>
				</div>
			</div>
		</div>
	</section>

	<section class="experience" aria-labelledby="experience-label">
		<div class="section-label" id="experience-label">Experience</div>
		<div class="timeline">
			{
				recentRoles.map((role, idx) => (
					<div class="post role" style={`--i: ${idx}`}>
						<div class="post-rail">
							<time class="post-date" datetime={toDateTimeRange(role.start, role.end)}>
								{formatDateRange(role.start, role.end)}
							</time>
							<span class="post-dot" aria-hidden="true" />
						</div>
						<div class="post-body">
							<h2 class="post-title">
								{role.role} <span class="at">at</span> {role.company}
							</h2>
							<div class="role-meta">{formatDateRange(role.start, role.end)}</div>
							<p class="post-preview">{role.summary}</p>
						</div>
					</div>
				))
			}
			<div class="archive-link" style={`--i: ${recentRoles.length}`}>
				<a data-astro-prefetch href={withBase("/experience/")}>Full work history →</a>
			</div>
		</div>
	</section>

	{
		featuredProjects.length > 0 && (
			<section class="work" aria-labelledby="work-label">
				<div class="section-label" id="work-label">Selected projects</div>
				<ul class="work-list">
					{featuredProjects.map((project, idx) => (
						<li style={`--i: ${idx + 1}`}>
							{project.href ? (
								<a href={project.href} rel="noreferrer" target="_blank">
									<div class="head">
										<span class="name">{project.name}</span>
										{project.badge && <span class="badge">{project.badge}</span>}
									</div>
									<div class="stack">{stackLine(project)}</div>
									<p>{project.desc}</p>
								</a>
							) : (
								<div class="entry">
									<div class="head">
										<span class="name">{project.name}</span>
										{project.badge && <span class="badge">{project.badge}</span>}
									</div>
									<div class="stack">{stackLine(project)}</div>
									<p>{project.desc}</p>
								</div>
							)}
						</li>
					))}
				</ul>
				<p class="more">
					<a data-astro-prefetch href={withBase("/projects/")}>
						All {projects.length} projects →
					</a>
				</p>
			</section>
		)
	}

	{
		recentWriting.length > 0 && (
			<section class="writing" aria-labelledby="writing-label">
				<div class="section-label" id="writing-label">Writing</div>
				<ul class="work-list">
					{recentWriting.map((item, idx) => (
						<li style={`--i: ${idx + 1}`}>
							<a href={item.href} rel="noreferrer" target="_blank">
								<div class="head">
									<span class="name">{item.title}</span>
									{item.source && <span class="stack">{item.source} ↗</span>}
								</div>
								{item.description && <p>{item.description}</p>}
							</a>
						</li>
					))}
				</ul>
				<p class="more">
					<a data-astro-prefetch href={withBase("/writing/")}>All writing →</a>
				</p>
			</section>
		)
	}
</PageLayout>

<style>
	/* ---------- Hero ---------- */
	.hero {
		margin-bottom: 76px;
	}
	.hero-grid {
		display: grid;
		grid-template-columns: 156px minmax(0, 1fr);
		gap: 36px;
		align-items: start;
	}
	/* 4:5 portrait; the 640×800 source stays crisp past 3× density. */
	.portrait {
		width: 156px;
		height: 195px;
		/* Drop by the paragraph's half-leading so the image's top edge lines up
		   with the first line's letters, not its (taller) line box. */
		margin-top: calc((1.65em - 1em) / 2);
		font-size: 19.5px;
		border-radius: 2px;
		object-fit: cover;
		background: var(--paper);
		border: 1px solid var(--hairline);
		transition: background-color 0.35s ease, border-color 0.35s ease;
	}
	.hero-text {
		min-width: 0;
	}
	.hero-text > p {
		font-size: 19.5px;
		line-height: 1.65;
		color: hsl(var(--theme-text));
		margin: 0 0 18px;
		max-width: 60ch;
		text-wrap: pretty;
	}
	.hero-text > p:last-of-type {
		margin-bottom: 0;
	}
	.socials {
		font-family: var(--font-sans);
		font-size: 13.5px;
		color: hsl(var(--theme-text) / 0.72);
		margin-top: 18px;
	}
	.socials a {
		color: hsl(var(--theme-text-muted));
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.35);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}
	.socials a:hover {
		color: hsl(var(--theme-accent));
		text-decoration-color: hsl(var(--theme-accent));
	}
	.socials .sep {
		color: var(--faint);
		margin: 0 9px;
	}

	/* ---------- Experience preview ---------- */
	.experience {
		margin-bottom: 84px;
	}
	/* Date ranges need a wider rail than the theme's single-date default. */
	.timeline {
		--rail-width: 172px;
	}
	.at {
		color: hsl(var(--theme-text) / 0.55);
		font-weight: 400;
	}
	.role-meta {
		display: none;
	}
	/* These rows aren't links, so suppress the timeline's clickable affordances. */
	.timeline :global(.role:hover .post-title) {
		color: hsl(var(--theme-text));
	}
	.timeline :global(.role:hover .post-dot) {
		background: hsl(var(--theme-bg));
		border-color: var(--faint);
		box-shadow: none;
	}
	.timeline :global(.role:hover .post-date) {
		color: hsl(var(--theme-text) / 0.72);
	}
	.timeline :global(.role:active) {
		transform: none;
		opacity: 1;
	}
	.timeline :global(.role .post-preview) {
		-webkit-line-clamp: 2;
	}

	.archive-link {
		grid-column: 2;
		margin-top: 8px;
		font-family: var(--font-sans);
		font-size: 13.5px;
		color: hsl(var(--theme-text) / 0.72);
	}
	.archive-link a,
	.more a {
		display: inline-block;
		padding: 6px 0;
		color: hsl(var(--theme-text-muted));
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.35);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}
	.archive-link a:hover,
	.more a:hover {
		color: hsl(var(--theme-accent));
		text-decoration-color: hsl(var(--theme-accent));
	}

	.work,
	.writing {
		margin-bottom: 88px;
	}
	.work :global(ul.work-list .entry) {
		display: block;
	}
	/* Long project names make name + stack + badge wrap unpredictably on one
	   line, so the stack gets its own. */
	.work :global(ul.work-list .head) {
		margin-bottom: 4px;
	}
	.work :global(ul.work-list .stack) {
		display: block;
	}
	.work :global(ul.work-list .badge) {
		flex: none;
	}
	.more {
		margin: 14px 0 0;
		font-family: var(--font-sans);
		font-size: 13.5px;
	}

	.socials a:focus-visible,
	.archive-link a:focus-visible,
	.more a:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
		border-radius: 3px;
	}

	@media (max-width: 720px) {
		.hero {
			margin-bottom: 56px;
		}
		/* Two columns leave too little room for the text at phone widths. */
		.hero-grid {
			grid-template-columns: 1fr;
			gap: 22px;
			justify-items: start;
		}
		.portrait {
			width: 120px;
			height: 150px;
		}
		.hero-text > p {
			font-size: 18px;
		}
		.role-meta {
			display: block;
			font-family: var(--font-mono);
			font-size: 11.5px;
			color: hsl(var(--theme-text) / 0.6);
			margin-bottom: 8px;
			font-variant-numeric: tabular-nums;
		}
		.timeline :global(.role .post-rail) {
			display: none;
		}
		.archive-link {
			margin-top: 0;
		}
	}

	@media (max-width: 420px) {
		.hero {
			margin-bottom: 48px;
		}
		.hero-text > p {
			font-size: 17px;
		}
		.socials {
			font-size: 12.5px;
		}
		.socials .sep {
			margin: 0 6px;
		}
		.experience {
			margin-bottom: 64px;
		}
		.work,
		.writing {
			margin-bottom: 56px;
		}
	}
</style>
