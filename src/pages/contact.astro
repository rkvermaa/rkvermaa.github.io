---
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
import { absoluteUrl, withBase } from "@/utils/path";
import { Schema } from "astro-seo-schema";

const siteUrl = (path: string) => absoluteUrl(path, Astro.site);
const profile = siteConfig.profile;
const accessKey = siteConfig.contact?.web3formsKey;

/** Only used on the no-JS path; the fetch handler preventDefault()s. */
const redirectUrl = siteUrl("/contact/");

/** `tel:` needs the number without spaces. */
const telHref = profile?.phone ? `tel:${profile.phone.replace(/[^\d+]/g, "")}` : undefined;
---

<Schema
	item={{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "Home",
				item: siteUrl("/"),
			},
			{
				"@type": "ListItem",
				position: 2,
				name: "Contact",
				item: siteUrl("/contact/"),
			},
		],
	}}
/>

<PageLayout
	meta={{
		title: "Contact",
		description: "Get in touch about AI engineering, GenAI systems or data platform work.",
	}}
>
	<section class="contact" aria-labelledby="contact-label">
		<div class="section-label" id="contact-label">Contact</div>
		<p class="intro">
			If you're building something in GenAI or data engineering — or you just want to compare notes
			— send a message. I read everything and reply to most of it.
		</p>

		<div class="columns">
			{
				accessKey && (
					<form
						class="form"
						id="contact-form"
						action="https://api.web3forms.com/submit"
						method="POST"
					>
						<input type="hidden" name="access_key" value={accessKey} />
						<input type="hidden" name="redirect" value={redirectUrl} />
						<input type="hidden" name="from_name" value={siteConfig.title} />
						{/* Web3Forms' documented spam trap — bots tick it, humans never see it. */}
						<input
							type="checkbox"
							name="botcheck"
							class="hp"
							tabindex="-1"
							autocomplete="off"
							aria-hidden="true"
						/>

						<div class="field">
							<label for="name">Name</label>
							<input type="text" id="name" name="name" required autocomplete="name" />
						</div>
						<div class="field">
							<label for="email">Email</label>
							<input type="email" id="email" name="email" required autocomplete="email" />
						</div>
						<div class="field">
							<label for="subject">Subject</label>
							<input type="text" id="subject" name="subject" />
						</div>
						<div class="field">
							<label for="message">Message</label>
							<textarea id="message" name="message" rows="6" required />
						</div>

						<button type="submit" id="contact-submit">Send message</button>
						<p class="status" id="contact-status" role="status" aria-live="polite" />
					</form>
				)
			}

			<aside class="details">
				<h2>Elsewhere</h2>
				<dl>
					{
						profile?.email && (
							<div>
								<dt>Email</dt>
								<dd>
									<a href={`mailto:${profile.email}`}>{profile.email}</a>
								</dd>
							</div>
						)
					}
					{
						profile?.phone && telHref && (
							<div>
								<dt>Phone</dt>
								<dd>
									<a href={telHref}>{profile.phone}</a>
								</dd>
							</div>
						)
					}
					{
						profile?.location && (
							<div>
								<dt>Location</dt>
								<dd>{profile.location}</dd>
							</div>
						)
					}
					{
						profile?.linkedin && (
							<div>
								<dt>LinkedIn</dt>
								<dd>
									<a href={profile.linkedin} rel="noreferrer" target="_blank">
										/in/ravi-kumar-verma
									</a>
								</dd>
							</div>
						)
					}
					{
						profile?.github && (
							<div>
								<dt>GitHub</dt>
								<dd>
									<a href={profile.github} rel="noreferrer" target="_blank">
										@rkvermaa
									</a>
								</dd>
							</div>
						)
					}
					{
						profile?.resume && (
							<div>
								<dt>Résumé</dt>
								<dd>
									<a href={withBase(profile.resume)}>Download PDF</a>
								</dd>
							</div>
						)
					}
				</dl>
			</aside>
		</div>
	</section>
</PageLayout>

<script>
	const form = document.querySelector<HTMLFormElement>("#contact-form");
	const status = document.querySelector<HTMLParagraphElement>("#contact-status");
	const submit = document.querySelector<HTMLButtonElement>("#contact-submit");

	if (form && status && submit) {
		const label = submit.textContent ?? "Send message";

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			status.textContent = "";
			status.className = "status";
			submit.disabled = true;
			submit.setAttribute("aria-busy", "true");
			submit.textContent = "Sending…";

			try {
				const response = await fetch(form.action, {
					method: "POST",
					body: new FormData(form),
				});
				const result = await response.json();

				if (response.ok && result.success) {
					status.textContent = "Message sent. I'll get back to you soon.";
					status.className = "status ok";
					form.reset();
				} else {
					status.textContent =
						"That didn't send. Please email me directly at rkverma87@gmail.com.";
					status.className = "status err";
				}
			} catch {
				status.textContent =
					"That didn't send — check your connection, or email me at rkverma87@gmail.com.";
				status.className = "status err";
			} finally {
				submit.disabled = false;
				submit.removeAttribute("aria-busy");
				submit.textContent = label;
			}
		});
	}
</script>

<style>
	.contact {
		margin-bottom: 88px;
	}
	.intro {
		font-family: var(--font-serif);
		font-size: 17.5px;
		line-height: 1.7;
		color: hsl(var(--theme-text));
		margin: 0 0 40px;
		max-width: 60ch;
		text-wrap: pretty;
	}
	.columns {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
		gap: 48px;
		align-items: start;
	}

	/* ---------- Form ---------- */
	.hp {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
	}
	.field {
		margin-bottom: 20px;
	}
	.field label {
		display: block;
		font-family: var(--font-sans);
		font-size: 11.5px;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: hsl(var(--theme-text) / 0.72);
		margin-bottom: 7px;
	}
	.field input,
	.field textarea {
		display: block;
		width: 100%;
		box-sizing: border-box;
		padding: 10px 12px;
		font-family: var(--font-sans);
		font-size: 15px;
		line-height: 1.5;
		color: hsl(var(--theme-text));
		background: transparent;
		border: 1px solid var(--hairline);
		border-radius: 0;
		transition: border-color 0.2s ease;
	}
	.field textarea {
		resize: vertical;
		min-height: 132px;
	}
	.field input:hover,
	.field textarea:hover {
		border-color: hsl(var(--theme-text) / 0.4);
	}
	.field input:focus-visible,
	.field textarea:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: -1px;
		border-color: hsl(var(--theme-accent));
	}
	button[type="submit"] {
		font-family: var(--font-sans);
		font-size: 13.5px;
		font-weight: 500;
		color: hsl(var(--theme-text));
		background: transparent;
		border: 1px solid hsl(var(--theme-text) / 0.45);
		padding: 10px 22px;
		cursor: pointer;
		transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
	}
	button[type="submit"]:hover:not(:disabled) {
		color: hsl(var(--theme-accent));
		border-color: hsl(var(--theme-accent));
		background: var(--accent-soft);
	}
	button[type="submit"]:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
	}
	button[type="submit"]:disabled {
		opacity: 0.55;
		cursor: default;
	}
	.status {
		font-family: var(--font-sans);
		font-size: 13.5px;
		line-height: 1.5;
		margin: 14px 0 0;
		min-height: 1.2em;
	}
	.status.ok {
		color: hsl(var(--theme-accent));
	}
	.status.err {
		color: hsl(var(--aside-warning));
	}

	/* ---------- Details ---------- */
	.details h2 {
		font-family: var(--font-sans);
		font-size: 11.5px;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: hsl(var(--theme-text) / 0.72);
		margin: 0 0 18px;
	}
	.details dl {
		margin: 0;
	}
	.details dl > div {
		padding: 12px 0;
		border-top: 1px solid var(--hairline);
	}
	.details dl > div:last-child {
		border-bottom: 1px solid var(--hairline);
	}
	.details dt {
		font-family: var(--font-mono);
		font-size: 10.5px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: hsl(var(--theme-text) / 0.55);
		margin-bottom: 4px;
	}
	.details dd {
		margin: 0;
		font-size: 15.5px;
		color: hsl(var(--theme-text-muted));
		word-wrap: break-word;
		overflow-wrap: anywhere;
	}
	.details dd a {
		color: hsl(var(--theme-text-muted));
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.35);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}
	.details dd a:hover {
		color: hsl(var(--theme-accent));
		text-decoration-color: hsl(var(--theme-accent));
	}
	.details dd a:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
		border-radius: 3px;
	}

	@media (max-width: 720px) {
		.intro {
			font-size: 17px;
			margin-bottom: 30px;
		}
		.columns {
			grid-template-columns: 1fr;
			gap: 44px;
		}
	}
	@media (max-width: 420px) {
		.contact {
			margin-bottom: 56px;
		}
		.intro {
			font-size: 16.5px;
		}
		button[type="submit"] {
			width: 100%;
		}
	}
</style>
