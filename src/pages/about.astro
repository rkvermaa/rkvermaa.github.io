---
import { getEntry, render } from "astro:content";
import { education } from "@/data/education";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
import { formatYearRange } from "@/utils/date";
import { absoluteUrl } from "@/utils/path";
import { Schema } from "astro-seo-schema";

const entry = await getEntry("page", "about");
if (!entry) throw new Error("Missing src/content/page/about.md");
const { Content } = await render(entry);

const profile = siteConfig.profile;
const authorName = profile?.name ?? siteConfig.author;

const meta = {
	description: entry.data.description ?? `${authorName} — about me.`,
	title: entry.data.title,
};

const personSameAs = [
	profile?.linkedin,
	profile?.github,
	profile?.twitter,
	profile?.mastodon,
].filter((s): s is string => Boolean(s));

const avatarUrl = profile?.avatar ? absoluteUrl(profile.avatar, Astro.site) : undefined;
---

<Schema
	item={{
		"@context": "https://schema.org",
		"@type": "ProfilePage",
		mainEntity: {
			"@type": "Person",
			name: authorName,
			...(avatarUrl ? { image: avatarUrl } : {}),
			...(profile?.jobTitle ? { jobTitle: profile.jobTitle } : {}),
			...(profile?.employer
				? {
						worksFor: {
							"@type": "Organization",
							name: profile.employer,
							...(profile.employerUrl ? { url: profile.employerUrl } : {}),
						},
					}
				: {}),
			...(profile?.alumni
				? {
						alumniOf: {
							"@type": "CollegeOrUniversity",
							name: profile.alumni,
						},
					}
				: {}),
			...(personSameAs.length ? { sameAs: personSameAs } : {}),
		},
	}}
/>

<PageLayout meta={meta}>
	<section class="about" aria-labelledby="about-label">
		<div class="section-label" id="about-label">About</div>
		<div class="bio">
			<Content />
		</div>
	</section>

	{
		education.length > 0 && (
			<section class="education" aria-labelledby="education-label">
				<div class="section-label" id="education-label">
					Education
				</div>
				<ul class="edu-list">
					{education.map((item) => (
						<li>
							<div class="edu-head">
								<span class="degree">{item.degree}</span>
								<span class="years">{formatYearRange(item.start, item.end)}</span>
							</div>
							{item.field && <div class="field">{item.field}</div>}
							<div class="institution">
								{item.institution}
								{item.location && <span class="place"> · {item.location}</span>}
							</div>
							{item.note && <p class="note">{item.note}</p>}
						</li>
					))}
				</ul>
			</section>
		)
	}
</PageLayout>

<style>
	.about {
		margin-bottom: 64px;
	}
	.bio {
		font-family: var(--font-serif);
		font-size: 17.5px;
		line-height: 1.75;
		color: hsl(var(--theme-text));
		max-width: var(--reading-width);
	}
	.bio :global(ul) {
		list-style: disc;
		list-style-position: inside;
		margin: 0 0 28px;
		padding: 0;
	}
	.bio :global(ul li) {
		margin-bottom: 6px;
		text-wrap: pretty;
		word-wrap: break-word;
		overflow-wrap: anywhere;
	}
	.bio :global(ul li:last-child) {
		margin-bottom: 0;
	}
	.bio :global(p) {
		margin: 0 0 22px;
		text-wrap: pretty;
	}
	.bio :global(p:last-child) {
		margin-bottom: 0;
	}
	.bio :global(a) {
		color: hsl(var(--theme-text));
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.35);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}
	.bio :global(a:hover) {
		color: hsl(var(--theme-accent));
		text-decoration-color: hsl(var(--theme-accent));
	}
	.bio :global(a:focus-visible) {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
		border-radius: 3px;
	}

	.education {
		margin-bottom: 72px;
	}
	.edu-list {
		list-style: none;
		margin: 0;
		padding: 0;
		max-width: var(--reading-width);
	}
	.edu-list li {
		padding: 18px 0;
		border-top: 1px solid var(--hairline);
	}
	.edu-list li:last-child {
		border-bottom: 1px solid var(--hairline);
	}
	.edu-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 14px;
		flex-wrap: wrap;
	}
	.degree {
		font-family: var(--font-serif);
		font-size: 18.5px;
		font-weight: 600;
		letter-spacing: -0.012em;
		color: hsl(var(--theme-text));
	}
	.years {
		font-family: var(--font-mono);
		font-size: 11.5px;
		color: hsl(var(--theme-text) / 0.6);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.field {
		font-size: 16px;
		line-height: 1.5;
		color: hsl(var(--theme-text-muted));
		margin-top: 4px;
		text-wrap: pretty;
	}
	.institution {
		font-family: var(--font-sans);
		font-size: 13.5px;
		color: hsl(var(--theme-text) / 0.66);
		margin-top: 6px;
	}
	.place {
		color: hsl(var(--theme-text) / 0.5);
	}
	.edu-list .note {
		font-size: 15px;
		color: hsl(var(--theme-text) / 0.66);
		margin: 8px 0 0;
	}

	@media (max-width: 720px) {
		.bio {
			font-size: 17px;
			line-height: 1.7;
		}
		.degree {
			font-size: 17.5px;
		}
	}
	@media (max-width: 420px) {
		.bio {
			font-size: 16.5px;
		}
		.education {
			margin-bottom: 52px;
		}
		.field {
			font-size: 15.5px;
		}
	}
</style>
